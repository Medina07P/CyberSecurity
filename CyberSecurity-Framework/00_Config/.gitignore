# Credenciales - NUNCA SUBIR A GIT
# Se ignora el contenido, pero no el andamiaje del directorio
credentials/*
!credentials/README.md
!credentials/.gitkeep
*.gpg
*.enc
credenciales_*.txt
passwords_*.txt

# Archivos temporales
*.tmp
*.temp
*.log
*.swp
*.swo

# Objetivo de la sesión del gestor (estado local, no se versiona)
.session

# Configuración real local: se versionan solo las plantillas *.example.
# (Copia con: cp scope.yaml.example scope.yaml  /  cp targets.txt.example targets.txt)
scope.yaml
targets.txt
!scope.yaml.example
!targets.txt.example

# Backups
*.bak
*.backup
*~

# Configuraciones sensibles
*.key
*.pem
*.crt
*.pfx
*.p12
*.jks

# No subir archivos grandes
*.pcap
*.pcapng
*.iso
*.ova
*.vmdk
*.vdi
