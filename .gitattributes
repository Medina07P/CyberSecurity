# Normalización de finales de línea.
# core.autocrlf=true está activo en este clon de Windows: sin esto, un
# checkout deja los scripts en CRLF y bash falla con «\r: command not found».

* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.ps1   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf

# Sin conversión: binarios y artefactos
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
*.pcap  binary
*.pcapng binary
